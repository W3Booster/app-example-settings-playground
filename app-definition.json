{
  "name": "Broadcast Controller",
  "description": "Prepare a broadcast title privately, save it, then show or hide the SDK-synced lower third on stream. An operator app plus stream output, without an in-game overlay.",
  "surfaces": [
    "application",
    "streamOverlay"
  ],
  "scopes": [
    "match:read"
  ],
  "settingsSchema": {
    "version": 1,
    "sections": [
      {
        "id": "display",
        "title": "Broadcast",
        "description": "",
        "groups": [
          {
            "id": "appearance",
            "title": "On-air output",
            "description": ""
          }
        ],
        "fields": [
          {
            "key": "display.title",
            "label": "Broadcast title",
            "type": "text",
            "group": "appearance",
            "default": "Community Cup · Round 1"
          },
          {
            "key": "display.onAir",
            "label": "Show title on stream",
            "type": "boolean",
            "group": "appearance",
            "default": false
          }
        ]
      }
    ]
  },
  "applicationUrl": "http://localhost:5173/?demo=0",
  "streamOverlayUrl": "http://localhost:5173/?view=overlay&demo=0"
}
